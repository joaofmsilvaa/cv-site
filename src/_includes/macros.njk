{% macro educationList(items, h = "h3") %}
<ol class="timeline">
  {%- for e in items %}
  <li>
    <p class="when"><time datetime="{{ e.start }}">{{ e.start | monthYear }}</time> – {% if e.end == "present" %}present{% else %}<time datetime="{{ e.end }}">{{ e.end | monthYear }}</time>{% endif %}</p>
    <{{ h }}>{{ e.degree }}</{{ h }}>
    <p class="where">{{ e.institution }}{% if e.location %}, {{ e.location }}{% endif %}</p>
    {% if e.description %}<p>{{ e.description }}</p>{% endif %}
    {% if e.courses.length %}<p>Courses taken: {{ e.courses | join(", ") }}.</p>{% endif %}
    {% if e.eqf_level %}<p class="meta">European Qualifications Framework (EQF) level {{ e.eqf_level }}.</p>{% endif %}
    {% if e.url %}<p class="meta"><a href="{{ e.url }}">{{ e.url }}</a></p>{% endif %}
  </li>
  {%- endfor %}
</ol>
{% endmacro %}

{% macro experienceList(items, h = "h3") %}
<ol class="timeline">
  {%- for x in items %}
  <li>
    <p class="when"><time datetime="{{ x.start }}">{{ x.start | monthYear }}</time> – {% if x.end == "present" %}present{% else %}<time datetime="{{ x.end }}">{{ x.end | monthYear }}</time>{% endif %}</p>
    <{{ h }}>{{ x.role }}</{{ h }}>
    <p class="where">{{ x.organization }}{% if x.location %}, {{ x.location }}{% endif %}</p>
    <p>{{ x.description }}</p>
    {% if x.technologies.length %}<p class="meta">Technologies: {{ x.technologies | join(", ") }}.</p>{% endif %}
  </li>
  {%- endfor %}
</ol>
{% endmacro %}

{% macro skillsBlock(skills, h = "h3") %}
<div class="skill-groups">
  {%- for g in skills.groups %}
  <section>
    <{{ h }}>{{ g.name }}</{{ h }}>
    <ul class="tags">{% for s in g.items %}<li>{{ s }}</li>{% endfor %}</ul>
  </section>
  {%- endfor %}
  <section>
    <{{ h }}>Languages</{{ h }}>
    <ul class="plain">{% for l in skills.languages %}<li><strong>{{ l.language }}</strong>: {{ l.level }}</li>{% endfor %}</ul>
  </section>
</div>
{% endmacro %}

{% macro projectsBlock(pr, h = "h3") %}
<ol class="timeline">
  {%- for x in pr.projects %}
  <li>
    <p class="when">{{ x.start | range(x.end) }}</p>
    <{{ h }}>{% if x.url %}<a href="{{ x.url }}">{{ x.name }}</a>{% else %}{{ x.name }}{% endif %}</{{ h }}>
    <p>{{ x.description }}</p>
    {% if x.technologies.length %}<p class="meta">Technologies: {{ x.technologies | join(", ") }}.</p>{% endif %}
  </li>
  {%- endfor %}
</ol>
{% endmacro %}

{% macro certificatesBlock(pr) %}
<ul class="plain">
  {%- for c in pr.certificates %}
  <li><strong>{{ c.name }}</strong>, {{ c.issuer }} (<time datetime="{{ c.date }}">{{ c.date | monthYear }}</time>)</li>
  {%- endfor %}
</ul>
{% endmacro %}

{% macro volunteeringBlock(pr) %}
<ul class="plain">
  {%- for v in pr.volunteering %}
  <li><strong>{{ v.role }}</strong>, {{ v.organization }} ({{ v.start | range(v.end) }})</li>
  {%- endfor %}
</ul>
{% endmacro %}
